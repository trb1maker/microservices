FROM golang:1.26.4-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o notification-service ./cmd/notification-service

FROM scratch

EXPOSE 9093

COPY --from=builder /src/notification-service /notification-service
COPY deploy/certs/notification-service/client.crt /certs/client.crt
COPY deploy/certs/notification-service/client.key /certs/client.key
COPY deploy/certs/ca/ca.crt /certs/ca.crt

ENTRYPOINT ["/notification-service"]
