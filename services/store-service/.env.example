NATS_URL=tls://localhost:4222
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=store
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_SERVICE_NAME=store-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
RESERVE_ITEMS_SUBJECT=cart.reserve_items
CONFIRM_ORDER_SUBJECT=orders.confirm
RELEASE_RESERVATION_SUBJECT=cart.release_reservation
ITEMS_RESERVED_SUBJECT=store.items_reserved
RESERVATION_FAILED_SUBJECT=store.reservation_failed
ORDER_CONFIRMED_SUBJECT=store.order_confirmed
RESERVATION_RELEASED_SUBJECT=store.reservation_released
NATS_TLS_CERT_FILE=/certs/client.crt
NATS_TLS_KEY_FILE=/certs/client.key
NATS_TLS_CA_FILE=/certs/ca.crt