NATS_URL=tls://localhost:4222
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
METRICS_PATH=/metrics
METRICS_ADDR=:9093
ORDER_FINALIZED_SUBJECT=orders.finalized
ORDER_CANCELLED_SUBJECT=orders.cancelled
PAYMENT_SUCCEEDED_SUBJECT=payment.succeeded
REFUND_SUCCEEDED_SUBJECT=payment.refund_succeeded
NATS_TLS_CERT_FILE=deploy/certs/notification-service/client.crt
NATS_TLS_KEY_FILE=deploy/certs/notification-service/client.key
NATS_TLS_CA_FILE=deploy/certs/ca/ca.crt
