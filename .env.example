# Shared config for docker compose, local UI, and tests (used directly — no .env copy needed).

# PostgreSQL
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
REPLICATION_PASSWORD=replicator

# order-service (docker compose network)
HTTP_ADDR=:8080
GRPC_ADDR=:50052
ORDER_GRPC_ADDR=localhost:50052
PAYMENT_GRPC_ADDR=payment-service:50051
DATABASE_URL=postgres://orders:orders@postgres:5432/orders?sslmode=disable
REDIS_ADDR=redis:6379
CART_TTL=24h
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
NATS_URL=tls://nats:4222
USE_MEMORY=false
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SDK_DISABLED=false
METRICS_PATH=/metrics
ACTIVE_ORDERS_REFRESH_SEC=30
ORDER_CREATED_SUBJECT=orders.created
RESERVE_ITEMS_SUBJECT=cart.reserve_items
CONFIRM_ORDER_SUBJECT=orders.confirm
RELEASE_RESERVATION_SUBJECT=cart.release_reservation
ORDER_FINALIZED_SUBJECT=orders.finalized
ORDER_CANCELLED_SUBJECT=orders.cancelled
ITEMS_RESERVED_SUBJECT=store.items_reserved
RESERVATION_FAILED_SUBJECT=store.reservation_failed
ORDER_CONFIRMED_SUBJECT=store.order_confirmed
STORE_HEALTH_URL=http://store-service:9092/ready
PAYMENT_HEALTH_URL=http://payment-service:9091/ready

# Demo users (seeded in order-service migration):
# demo@example.com / demo123
# admin@example.com / admin123

# Security
JWT_SECRET=dev-jwt-secret-minimum-32-characters-long
JWT_TTL=24h
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
TLS_CLIENT_CA_FILE=/certs/ca.crt
NATS_TLS_CERT_FILE=/certs/client.crt
NATS_TLS_KEY_FILE=/certs/client.key
NATS_TLS_CA_FILE=/certs/ca.crt
MTLS_SERVICE_CNS=order-service,payment-service

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Jaeger
COLLECTOR_OTLP_ENABLED=true

# postgres-exporter
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://orders:orders@postgres:5432/orders?sslmode=disable

# payment-service (listen address set in docker-compose)
PAYMENT_DATABASE_URL=postgres://orders:orders@postgres:5432/payments?sslmode=disable
PAYMENT_OTEL_SERVICE_NAME=payment-service
SHUTDOWN_TIMEOUT=10s
PAYMENT_SUCCEEDED_SUBJECT=payment.succeeded
PAYMENT_FAILED_SUBJECT=payment.failed
REFUND_SUCCEEDED_SUBJECT=payment.refund_succeeded
REFUND_FAILED_SUBJECT=payment.refund_failed

# store-service
STORE_MONGODB_URI=mongodb://mongodb:27017,mongodb-2:27017,mongodb-3:27017/?replicaSet=rs0
STORE_MONGODB_DB_NAME=store
STORE_OTEL_SERVICE_NAME=store-service
STOCK_LOCK_TTL=5s
STOCK_LOCK_RETRY_COUNT=20
STOCK_LOCK_RETRY_DELAY=50ms
RESERVATION_RELEASED_SUBJECT=store.reservation_released

# notification-service
NOTIFICATION_OTEL_SERVICE_NAME=notification-service
NOTIFICATION_METRICS_ADDR=:9093

# analytics-service
ANALYTICS_DATABASE_URL=postgres://orders:orders@postgres:5432/analytics?sslmode=disable
ANALYTICS_OTEL_SERVICE_NAME=analytics-service
ANALYTICS_METRICS_ADDR=:9094
ANALYTICS_HTTP_ADDR=:8084
RECEIPT_URL_TTL=15m
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false

# payment/store metrics
PAYMENT_METRICS_ADDR=:9091
STORE_METRICS_ADDR=:9092

# ui gateway
UI_HTTP_ADDR=:8081
ORDER_HTTP_URL=https://localhost:8080
TLS_CA_FILE=deploy/certs/ca/ca.crt
TLS_SKIP_VERIFY=true
UI_SESSION_SECRET=dev-ui-session-secret-minimum-32-chars

# --- Local development (override compose hostnames when running services on host) ---
# DATABASE_URL=postgres://orders:orders@localhost:5432/orders?sslmode=disable
# PAYMENT_DATABASE_URL=postgres://orders:orders@localhost:5432/payments?sslmode=disable
# ANALYTICS_DATABASE_URL=postgres://orders:orders@localhost:5432/analytics?sslmode=disable
# REDIS_ADDR=localhost:6379
# NATS_URL=tls://localhost:4222
